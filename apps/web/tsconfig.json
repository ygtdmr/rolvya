{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true, "verbatimModuleSyntax": true,
    "noEmit": true, "skipLibCheck": true, "types": ["vite/client", "vitest/globals", "node"]
  },
  "include": ["src", "tests", "*.ts"]
}
